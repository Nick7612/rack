pkgname=rack
pkgver=0.1.0
pkgrel=1
pkgdesc='Omarchy-only two-player 8-ball and 9-ball over your local network'
arch=('x86_64' 'aarch64')
url='https://github.com/Nick7612/rack'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/rack "$pkgdir/usr/bin/rack"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/rack.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/rack.svg"
  install -Dm644 "$startdir/rack.desktop" "$pkgdir/usr/share/applications/rack.desktop"
}
